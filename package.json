{
  "name": "nexus-route",
  "version": "1.3.0",
  "description": "High-performance, clean, modular AI model routing gateway",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "art:server": "python scripts/local_art_server.py",
    "build": "tsc && node -e \"fs.cpSync('src/web', 'dist/web', {recursive: true}); if (fs.existsSync('src/engine')) fs.cpSync('src/engine', 'dist/engine', {recursive: true, filter: (s) => s.endsWith('.py') || fs.statSync(s).isDirectory()})\"",
    "build:bundle": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.bundle.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build_exe.ps1",
    "build:exe:quick": "powershell -ExecutionPolicy Bypass -File scripts/build_exe.ps1 -SkipTests",
    "build:exe:selfcontained": "powershell -ExecutionPolicy Bypass -File scripts/build_exe.ps1 -SelfContained",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/build_exe.ps1 -SkipTests",
    "test": "vitest run",
    "test:chaos": "vitest run tests/chaos-resilience.test.ts",
    "mock:upstream": "tsx src/testing/mock-upstream-server.ts",
    "learning:benchmark": "tsx scripts/benchmark-suite.ts",
    "learning:self-correct": "tsx scripts/self-correcting-benchmark.ts",
    "learning:doctor": "tsx scripts/learning-doctor.ts",
    "learning:refresh": "tsx scripts/refresh-learning-sources.ts",
    "learning:maintain": "tsx scripts/learning-maintenance.ts",
    "learning:evolve": "tsx scripts/autonomous-learning-lab.ts"
  },
  "keywords": [
    "ai",
    "gateway",
    "router",
    "openai",
    "anthropic",
    "gemini",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
