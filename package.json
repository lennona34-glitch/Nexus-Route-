{
  "name": "nexus-route",
  "version": "1.3.0",
  "description": "High-performance, clean, modular AI model routing gateway",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "art:server": "python scripts/local_art_server.py",
    "build": "tsc && node -e \"fs.cpSync('src/web', 'dist/web', {recursive: true})\"",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "gateway",
    "router",
    "openai",
    "anthropic",
    "gemini",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
