# ==========================================
# NexusRoute Environment Configuration Template
# ==========================================

# Server Network Settings
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Administrative Protection
# Leave unset to auto-generate a secure local token in data/.admin_secret
# ADMIN_API_KEY=your_secure_admin_key_here

# Upstream AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Which OpenRouter model the router dispatches to. Defaults to openrouter/free,
# the Free Models Router - free-variant models only, heavily rate limited.
# With a funded key set a paid slug or openrouter/auto, e.g.:
# OPENROUTER_MODEL=openrouter/auto
GITHUB_TOKEN=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=

# Agent loop budget. Each turn is one model call; tool results feed the next.
# Build->launch->test->fix cycles need headroom - lower this only to cap spend.
# NEXUS_MAX_AGENT_TURNS=8

# Anthropic prompt caching via OpenRouter. Anthropic models cache only when a
# breakpoint is sent (OpenAI models cache automatically), and an agent loop
# re-sends the whole conversation each turn, so this is where the savings are.
# Cache reads bill at 0.1x input. Set to "off" to disable.
# NEXUS_PROMPT_CACHE=on
# Cache lifetime: 5m (default, writes at 1.25x) or 1h (writes at 2x).
# NEXUS_PROMPT_CACHE_TTL=5m
